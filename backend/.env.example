REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
GEMINI_API_KEY=your-google-ai-studio-key
# Optional overrides
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=   # another Gemini model (its own quota), used when LLM_MODEL is rate-limited

# Embeddings: "local" (default, free, offline BAAI/bge-small-en-v1.5, 384-d)
# or "gemini" (models/gemini-embedding-001, 768-d, uses GEMINI_API_KEY quota).
# Each model gets its own Qdrant collection; re-index after switching.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=        # only with VECTOR_SIZE for non-default models
# VECTOR_SIZE=

# MCP endpoint (/mcp). Unset MCP_TOKEN = no auth, fine on localhost only.
# MCP_TOKEN=
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*

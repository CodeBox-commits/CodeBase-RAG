# Copy to deploy/.env (never commit it) and fill in real values.

# Public hostname. "localhost" for a local rehearsal.
DOMAIN=localhost

# Image to run. TAG is what you deploy and roll back: sha-<short>, main, or 0.1.0.
IMAGE=ghcr.io/codebox-commits/git-rag-project
TAG=main

# Used for answers (LLM). Embeddings are local and free by default.
GEMINI_API_KEY=your-google-ai-studio-key
# LLM_MODEL=gemini-3.5-flash-lite
# EMBEDDING_PROVIDER=local   # or "gemini"

# Generate strong values, e.g.: openssl rand -hex 24
NEO4J_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Bearer token for the MCP endpoint (/mcp); clients send "Authorization: Bearer <token>".
MCP_TOKEN=change-me

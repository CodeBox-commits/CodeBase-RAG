# DOMAIN comes from deploy/.env. A real domain gets a Let's Encrypt certificate
# automatically; "localhost" gets one from Caddy's local CA (for rehearsals).
{$DOMAIN} {
	encode zstd gzip

	# SSE (/api/v1/chat) works out of the box: Caddy flushes text/event-stream immediately.
	reverse_proxy api:8000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
